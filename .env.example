# Copy this file to .env and fill in what you need.
# server.js loads these via `systemd EnvironmentFile=` or any other .env
# loader you prefer -- it just reads process.env, nothing is bundled in.

# --- Networking ---
PORT=8100
# Where the machine's own web console lives (ttyd, a VNC-to-web bridge,
# whatever). Shown in the left panel and the "back" link.
CONSOLE_URL=http://localhost:8080
# Where pidp11-bootapi.py (or your own equivalent for a different machine)
# is reachable. Must expose GET /screen, POST /keys, GET /status under this
# base path.
BOOTAPI_BASE=http://localhost:8093/api/pidp11

# --- Control toggle ---
# How many send_keys/read_screen calls the agent gets per turn before it has
# to ask in plain text whether it may continue.
ACTION_LIMIT=5

# --- Local backend (default, free) ---
# Any OpenAI-compatible endpoint. A stock Ollama install already speaks this
# API at /v1 -- nothing extra to configure if you're running Ollama with the
# default settings and have pulled a model that supports tool calling
# (qwen3, llama3.1+, mistral-nemo, etc. all do).
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=
LOCAL_MODEL=qwen3:14b

# --- Cloud backend (optional, for a faster/smarter option) ---
# Any OpenAI-compatible hosted provider: OpenAI itself, Groq, Together,
# Fireworks, DeepSeek, Mistral, OpenRouter, a hosted vLLM/TGI endpoint, etc.
# Leave CLOUD_BASE_URL empty to disable the cloud toggle -- it will just
# return a clear error telling the user to configure it, instead of
# silently falling back to local.
#
# Examples:
#   OpenAI:      CLOUD_BASE_URL=https://api.openai.com/v1        CLOUD_MODEL=gpt-4o-mini
#   Groq:        CLOUD_BASE_URL=https://api.groq.com/openai/v1   CLOUD_MODEL=llama-3.3-70b-versatile
#   OpenRouter:  CLOUD_BASE_URL=https://openrouter.ai/api/v1     CLOUD_MODEL=<any tool-calling model on OpenRouter>
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=
